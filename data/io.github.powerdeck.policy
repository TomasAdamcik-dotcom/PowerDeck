<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PowerDeck</vendor>
  <vendor_url>https://github.com/TomasAdamcik-dotcom/PowerDeck</vendor_url>

  <action id="io.github.powerdeck.manage-power">
    <description>Change laptop power settings (lid behaviour, CPU limits)</description>
    <description xml:lang="sk">Zmeniť nastavenia napájania notebooku (veko, limity procesora)</description>
    <message>Authentication is required to change laptop lid and CPU power settings</message>
    <message xml:lang="sk">Na zmenu nastavení veka a výkonu procesora je potrebné overenie</message>
    <icon_name>preferences-system-power</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/powerdeck-helper</annotate>
  </action>

  <!-- `powerdeck no-password on|off`: installs or removes PowerDeck's own polkit rule (fixed
       content). Always asks for the password (no "keep"), so the password typed for a profile
       change a few minutes earlier cannot be reused to turn the prompt off for good. -->
  <action id="io.github.powerdeck.no-password">
    <description>Allow or stop changing PowerDeck's lid and CPU settings without a password</description>
    <description xml:lang="sk">Povoliť alebo zrušiť zmenu nastavení veka a procesora v PowerDecku bez hesla</description>
    <message>Authentication is required to change whether PowerDeck asks for the password</message>
    <message xml:lang="sk">Na zmenu toho, či PowerDeck pýta heslo, je potrebné overenie</message>
    <icon_name>preferences-system-power</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/powerdeck-nopassword</annotate>
  </action>

  <!-- Guard suspend: only suspends (ignoring inhibitors). Allowed without a password for the
       active local user so the guard can protect a laptop in a closed bag from overheating or
       from running flat (low battery). The id keeps its old name for existing installs. -->
  <action id="io.github.powerdeck.thermal-suspend">
    <description>Suspend an overheating or flat laptop</description>
    <description xml:lang="sk">Uspať prehriaty alebo vybitý notebook</description>
    <message>PowerDeck wants to suspend the laptop because the CPU reached its maximum temperature or the battery is low</message>
    <message xml:lang="sk">PowerDeck chce uspať notebook, lebo CPU dosiahol maximálnu teplotu alebo je slabá batéria</message>
    <icon_name>preferences-system-power</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/powerdeck-suspend</annotate>
  </action>
</policyconfig>
