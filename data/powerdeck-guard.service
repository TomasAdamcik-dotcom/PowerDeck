[Unit]
Description=PowerDeck thermal and battery guard
# needs the graphical session (notifications, screensaver, gsettings); not in the GDM greeter
PartOf=graphical-session.target
After=graphical-session.target
ConditionUser=!@system

[Service]
ExecStart=/usr/bin/powerdeck guard --interval 30
Restart=on-failure

[Install]
WantedBy=graphical-session.target
